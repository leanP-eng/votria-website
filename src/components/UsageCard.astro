---
interface Props {
  title: string;
  hook: string;
  description: string;
  type?: 'usage' | 'gain' | 'rgpd' | 'livrable';
}

const { title, hook, description, type = 'usage' } = Astro.props;

const typeStyles: Record<string, { border: string; hookColor: string; bg: string }> = {
  usage:    { border: 'border-l-4 border-orange-500', hookColor: 'text-orange-600', bg: 'bg-white' },
  gain:     { border: 'border-l-4 border-green-500',  hookColor: 'text-green-700',  bg: 'bg-green-50' },
  rgpd:     { border: 'border-l-4 border-red-500',    hookColor: 'text-red-700',    bg: 'bg-red-50' },
  livrable: { border: 'border-l-4 border-orange-400', hookColor: 'text-orange-700', bg: 'bg-orange-50' },
};

const s = typeStyles[type];
---

<div class={`${s.bg} ${s.border} rounded-r-xl p-6 mb-4`}>
  <h3 class="text-lg font-bold text-navy-900 mb-2">{title}</h3>
  <p class={`text-sm italic mb-3 ${s.hookColor}`}>"{hook}"</p>
  <p class="text-gray-600 text-sm leading-relaxed">{description}</p>
</div>
