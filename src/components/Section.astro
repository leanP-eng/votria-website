---
interface Props {
  variant?: 'navy' | 'light' | 'white' | 'cta';
  class?: string;
  id?: string;
}

const { variant = 'white', class: className = '', id } = Astro.props;

const variants: Record<string, string> = {
  navy: 'bg-navy-900 text-white',
  light: 'bg-navy-50 text-navy-900',
  white: 'bg-white text-navy-900',
  cta:  'bg-navy-900 text-white',
};
---

<section id={id} class={`${variants[variant]} py-16 px-6 md:px-12 lg:px-20 ${className}`}>
  <div class="max-w-6xl mx-auto">
    <slot />
  </div>
</section>
