---
import Button from './Button.astro';
const n8nUrl = import.meta.env.N8N_WEBHOOK_URL ?? 'https://placeholder.n8n.cloud/webhook/contact';
---

<form
  id="contact-form"
  class="max-w-2xl mx-auto"
  novalidate
  aria-label="Formulaire de diagnostic gratuit"
>
  <!-- Honeypot anti-bot : invisible, ne pas remplir. -->
  <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;width:0;overflow:hidden;">
    <label for="website">Ne pas remplir ce champ</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <!-- Prénom + Nom -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div>
      <label for="prenom" class="block text-sm font-medium text-navy-900 mb-1">Prénom <span class="text-red-600" aria-hidden="true">*</span></label>
      <input type="text" id="prenom" name="prenom" required autocomplete="given-name"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg text-navy-900 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent min-h-[44px]"
        aria-required="true"
      />
    </div>
    <div>
      <label for="nom" class="block text-sm font-medium text-navy-900 mb-1">Nom <span class="text-red-600" aria-hidden="true">*</span></label>
      <input type="text" id="nom" name="nom" required autocomplete="family-name"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg text-navy-900 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent min-h-[44px]"
        aria-required="true"
      />
    </div>
  </div>

  <!-- Entreprise -->
  <div class="mb-4">
    <label for="entreprise" class="block text-sm font-medium text-navy-900 mb-1">Entreprise <span class="text-red-600" aria-hidden="true">*</span></label>
    <input type="text" id="entreprise" name="entreprise" required autocomplete="organization"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg text-navy-900 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent min-h-[44px]"
      aria-required="true"
    />
  </div>

  <!-- Secteur + Effectif -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div>
      <label for="secteur" class="block text-sm font-medium text-navy-900 mb-1">Secteur d'activité <span class="text-red-600" aria-hidden="true">*</span></label>
      <select id="secteur" name="secteur" required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg text-navy-900 bg-white focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent min-h-[44px]"
        aria-required="true"
      >
        <option value="">Sélectionnez votre secteur</option>
        <option value="btp">BTP</option>
        <option value="industrie">Industrie</option>
        <option value="negoce">Négoce / Distribution</option>
        <option value="commerce">Commerce</option>
        <option value="services">Services</option>
        <option value="rh">RH / Recrutement</option>
        <option value="autre">Autre</option>
      </select>
    </div>
    <div>
      <label for="effectif" class="block text-sm font-medium text-navy-900 mb-1">Effectif <span class="text-red-600" aria-hidden="true">*</span></label>
      <select id="effectif" name="effectif" required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg text-navy-900 bg-white focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent min-h-[44px]"
        aria-required="true"
      >
        <option value="">Nombre de personnes</option>
        <option value="1-5">1 à 5</option>
        <option value="6-20">6 à 20</option>
        <option value="21-50">21 à 50</option>
        <option value="+50">Plus de 50</option>
      </select>
    </div>
  </div>

  <!-- Sujet principal (checkboxes) -->
  <div class="mb-4">
    <fieldset>
      <legend class="block text-sm font-medium text-navy-900 mb-2">Sujet principal <span class="text-red-600" aria-hidden="true">*</span></legend>
      <div class="flex flex-wrap gap-3" role="group">
        {[
          { value: 'formation', label: 'Formation' },
          { value: 'automatisation', label: 'Automatisation' },
          { value: 'integration', label: 'Intégration' },
          { value: 'rgpd', label: 'RGPD' },
          { value: 'autre', label: 'Autre' },
        ].map(({ value, label }) => (
          <label class="flex items-center gap-2 cursor-pointer min-h-[44px]">
            <input type="checkbox" name="sujet" value={value}
              class="w-4 h-4 accent-orange-500"
            />
            <span class="text-sm text-navy-900">{label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>

  <!-- Email -->
  <div class="mb-4">
    <label for="email" class="block text-sm font-medium text-navy-900 mb-1">Email <span class="text-red-600" aria-hidden="true">*</span></label>
    <input type="email" id="email" name="email" required autocomplete="email"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg text-navy-900 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent min-h-[44px]"
      aria-required="true"
    />
  </div>

  <!-- Message libre -->
  <div class="mb-4">
    <label for="message" class="block text-sm font-medium text-navy-900 mb-1">Message (optionnel)</label>
    <textarea id="message" name="message" rows="4" maxlength="1000"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg text-navy-900 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent resize-none"
      placeholder="Décrivez votre besoin ou contexte..."
    ></textarea>
    <p class="text-xs text-gray-400 mt-1">Maximum 1000 caractères</p>
  </div>

  <!-- Consentement RGPD -->
  <div class="mb-6">
    <label class="flex items-start gap-3 cursor-pointer">
      <input type="checkbox" id="rgpd" name="rgpd" required
        class="w-4 h-4 mt-1 accent-orange-500 flex-shrink-0"
        aria-required="true"
      />
      <span class="text-sm text-gray-600 leading-relaxed">
        J'accepte que mes données soient utilisées pour traiter ma demande de diagnostic IA, conformément à la
        <a href="/politique-confidentialite" class="text-navy-900 underline hover:text-orange-600">politique de confidentialité</a>.
        <span class="text-red-600" aria-hidden="true"> *</span>
      </span>
    </label>
  </div>

  <!-- Erreur globale -->
  <div id="form-error" role="alert" aria-live="polite" class="hidden mb-4 p-4 bg-red-50 border border-red-300 rounded-lg text-red-800 text-sm"></div>

  <!-- Submit -->
  <Button type="submit" variant="primary" class="w-full">
    Envoyer ma demande
  </Button>

  <!-- Message de succès -->
  <div id="success-message" role="status" class="hidden mt-6 p-8 bg-green-50 border border-green-200 rounded-xl text-green-900">
    <h3 class="text-xl font-bold mb-4">✅ Merci pour votre confiance !</h3>
    <p class="mb-3 text-green-800">
      Nous avons bien reçu votre demande.
    </p>
    <p class="mb-4 text-green-800">
      Notre équipe vous recontactera <strong>rapidement</strong>
      pour échanger sur vos besoins et des solutions d'IA adaptées.
    </p>
    <p class="text-sm text-green-700">
      En attendant, n'hésitez pas à consulter
      <a href="/methode-integration-ia" class="underline font-medium hover:text-green-900 transition-colors">notre méthode en 3 étapes</a>.
    </p>
  </div>
</form>

{/* L'URL webhook est visible dans le source HTML côté client.
    C'est inévitable pour un site 100% statique sans Netlify Function.
    Si cette URL ne doit pas être publique, migrer vers une Netlify Function proxy.
    Pour l'instant, le webhook n8n peut être sécurisé avec une clé API dans n8n lui-même. */}
<script define:vars={{ n8nUrl }}>
  const form = document.getElementById('contact-form');
  const errorDiv = document.getElementById('form-error');
  const successDiv = document.getElementById('success-message');

  const ALLOWED_SECTEURS = ['btp', 'industrie', 'negoce', 'commerce', 'services', 'rh', 'autre'];
  const ALLOWED_EFFECTIFS = ['1-5', '6-20', '21-50', '+50'];
  const ALLOWED_SUJETS = ['formation', 'automatisation', 'integration', 'rgpd', 'autre'];
  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function sanitize(str) {
    return String(str).replace(/[<>"'`]/g, '').trim().slice(0, 500);
  }

  function showError(msg) {
    if (errorDiv) {
      errorDiv.textContent = msg;
      errorDiv.classList.remove('hidden');
      errorDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function hideError() {
    errorDiv?.classList.add('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    const fd = new FormData(e.target);

    // Honeypot : si rempli, c'est un bot. Faux succès, aucun envoi.
    const honeypot = String(fd.get('website') ?? '').trim();
    if (honeypot !== '') {
      form.style.display = 'none';
      successDiv?.classList.remove('hidden');
      return;
    }

    const prenom = sanitize(fd.get('prenom') ?? '');
    const nom = sanitize(fd.get('nom') ?? '');
    const entreprise = sanitize(fd.get('entreprise') ?? '');
    const secteur = String(fd.get('secteur') ?? '');
    const effectif = String(fd.get('effectif') ?? '');
    const sujets = fd.getAll('sujet').map(String).filter(s => ALLOWED_SUJETS.includes(s));
    const email = String(fd.get('email') ?? '').trim();
    const message = sanitize(fd.get('message') ?? '').slice(0, 1000);
    const rgpd = fd.get('rgpd') === 'on';

    if (!prenom || !nom) return showError('Veuillez saisir votre prénom et votre nom.');
    if (!entreprise) return showError('Veuillez indiquer votre entreprise.');
    if (!ALLOWED_SECTEURS.includes(secteur)) return showError("Veuillez sélectionner votre secteur d'activité.");
    if (!ALLOWED_EFFECTIFS.includes(effectif)) return showError("Veuillez sélectionner l'effectif de votre entreprise.");
    if (sujets.length === 0) return showError('Veuillez sélectionner au moins un sujet principal.');
    if (!EMAIL_REGEX.test(email)) return showError('Veuillez saisir une adresse email valide.');
    if (!rgpd) return showError('Vous devez accepter la politique de confidentialité pour continuer.');

    const payload = {
      prenom, nom, entreprise, secteur, effectif, sujets, email, message,
      rgpd: true,
      _meta: {
        submittedAt: new Date().toISOString(),
        origin: window.location.origin,
        page: window.location.pathname,
      },
    };

    const submitBtn = form.querySelector('button[type="submit"]');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours…';
    }

    try {
      const res = await fetch(n8nUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      form.style.display = 'none';
      successDiv?.classList.remove('hidden');
    } catch {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Envoyer ma demande';
      }
      showError('Une erreur est survenue. Veuillez réessayer ou nous écrire directement à contact@votria.pro.');
    }
  });
</script>
