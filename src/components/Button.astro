---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { href, variant = 'primary', class: className = '', type = 'button' } = Astro.props;

const styles: Record<string, string> = {
  primary: 'bg-orange-500 text-navy-900 hover:bg-orange-600 focus:ring-orange-500',
  secondary: 'bg-transparent border-2 border-white text-white hover:bg-white hover:text-navy-900 focus:ring-white',
  outline: 'bg-transparent border-2 border-navy-900 text-navy-900 hover:bg-navy-50 focus:ring-navy-900',
};

const base = 'inline-flex items-center justify-center px-6 py-3 rounded-lg font-bold transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 min-h-[44px]';
const cls = `${base} ${styles[variant]} ${className}`;
---

{href ? (
  <a href={href} class={cls}>
    <slot />
  </a>
) : (
  <button type={type} class={cls}>
    <slot />
  </button>
)}
