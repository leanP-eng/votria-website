---
---

<div
  id="cookie-banner"
  role="dialog"
  aria-label="Bandeau de consentement aux cookies"
  aria-live="polite"
  class="fixed bottom-0 left-0 right-0 z-50 bg-navy-900 text-white shadow-2xl border-t border-navy-800"
>
  <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <p class="text-sm text-gray-200 leading-relaxed flex-1">
      Nous utilisons Google Analytics pour analyser le trafic et améliorer notre site.
      Vos données ne sont collectées qu'avec votre consentement.
      <a href="/politique-confidentialite" class="underline hover:text-orange-400 transition-colors">En savoir plus</a>
    </p>
    <div class="flex gap-3 flex-shrink-0">
      <button
        id="accept-cookies"
        class="bg-orange-500 text-navy-900 font-bold px-5 py-2.5 rounded-lg hover:bg-orange-600 transition-colors min-h-[44px] focus:outline-none focus:ring-2 focus:ring-orange-400"
        aria-label="Accepter les cookies analytics"
      >
        Accepter
      </button>
      <button
        id="reject-cookies"
        class="border border-white text-white px-5 py-2.5 rounded-lg hover:bg-navy-800 transition-colors min-h-[44px] focus:outline-none focus:ring-2 focus:ring-white"
        aria-label="Refuser les cookies analytics"
      >
        Refuser
      </button>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('accept-cookies');
  const rejectBtn = document.getElementById('reject-cookies');

  function hideBanner() {
    banner?.classList.add('hidden');
  }

  function loadGA4(gaId: string) {
    if (!gaId) return; // ← guard: ne pas injecter GA4 si l'ID est absent
    window.dataLayer = window.dataLayer || [];
    function gtag(...args: unknown[]) { window.dataLayer.push(args); }
    (window as Record<string, unknown>).gtag = gtag;

    gtag('consent', 'update', { analytics_storage: 'granted' });

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
    document.head.appendChild(script);

    script.onload = () => {
      gtag('js', new Date());
      gtag('config', gaId);
    };

    localStorage.setItem('votria_ga_consent', 'granted');
  }

  const GA_ID = (document.querySelector('meta[name="ga4-id"]') as HTMLMetaElement)?.content ?? '';

  acceptBtn?.addEventListener('click', () => {
    loadGA4(GA_ID);
    hideBanner();
  });

  rejectBtn?.addEventListener('click', () => {
    localStorage.setItem('votria_ga_consent', 'denied');
    hideBanner();
  });

  // Consentement déjà donné
  const stored = localStorage.getItem('votria_ga_consent');
  if (stored === 'granted') {
    if (GA_ID) loadGA4(GA_ID); // ← guard ajouté
    hideBanner();
  } else if (stored === 'denied') {
    hideBanner();
  }
</script>
