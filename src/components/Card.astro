---
interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className = '' } = Astro.props;
---

<div class={`bg-white border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-shadow duration-200 ${className}`}>
  <h3 class="text-xl font-bold mb-3 text-navy-900">{title}</h3>
  {description && <p class="text-gray-600 text-sm leading-relaxed mb-4">{description}</p>}
  <slot />
</div>
