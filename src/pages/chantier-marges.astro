---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import UsageCard from '../components/UsageCard.astro';
---

<BaseLayout
  title="Suivi de chantier & marges en temps réel | VotrIA"
  description="Alertes dérapage chantier, marges par affaire en temps réel, suivi sous-traitants — pour les PME du bâtiment qui veulent savoir si elles gagnent ou perdent de l'argent, sans attendre la clôture."
>
  <!-- Hero -->
  <Section variant="navy">
    <div class="py-12 text-white">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Quel chantier vous fait gagner de l'argent ? Et lequel vous en fait perdre ?</h1>
      <p class="text-xl text-gray-300 max-w-2xl mb-8">Sans tableau de bord en temps réel, vous le découvrez trop tard. Je mets en place le suivi marges et alertes dérapage qui vous permet d'agir pendant que le chantier tourne encore.</p>
      <div class="flex gap-4 flex-wrap">
        <Button href="/contact-diagnostic-ia" variant="primary">Diagnostic gratuit</Button>
        <Button href="/methode-integration-ia" variant="secondary">Voir la méthode</Button>
      </div>
    </div>
  </Section>

  <!-- Problème -->
  <Section variant="light">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">Ce que vous ne voyez pas pendant le chantier</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <Card
        title="Marges réelles connues trop tard"
        description="Vous faites le bilan à la clôture du chantier. Si les marges ont dérapé, c'est trop tard pour agir. L'argent est dépensé."
      />
      <Card
        title="Sous-traitants : coûts qui s'envolent silencieusement"
        description="Appels de fonds en retard, heures supplémentaires non prévues, matériaux rajoutés — les écarts s'accumulent sans alerte."
      />
      <Card
        title="Chantiers rentables et chantiers perdants mélangés"
        description="Sans vue consolidée, impossible de savoir quels types de chantiers sont vraiment rentables pour vous. On travaille à l'intuition."
      />
    </div>
  </Section>

  <!-- Solution -->
  <Section variant="white">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold mb-6 text-navy-900">La solution VotrIA</h2>
        <p class="text-gray-700 mb-4 leading-relaxed">
          Je connecte vos données chantier (devis, heures passées, factures sous-traitants) pour vous donner une vue marges en temps réel. Pas à la clôture — pendant que vous pouvez encore corriger.
        </p>
      </div>
      <div class="bg-orange-50 border-l-4 border-orange-500 rounded-r-xl p-6">
        <p class="text-sm font-bold text-orange-600 uppercase tracking-wide mb-3">Cas concret BTP</p>
        <p class="text-navy-900 font-medium leading-relaxed">
          Un gérant BTP suit ses marges clients en temps réel, identifie les chantiers sous-performants chaque semaine et ajuste ses priorités — sans passer 3h à consolider des tableurs. Il a récupéré 8 points de marge sur ses chantiers cuisine en repositionnant son prix.
        </p>
      </div>
    </div>
  </Section>

  <!-- 4 usages concrets -->
  <Section variant="light">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">Ce que je mets en place concrètement</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <UsageCard
        title="Suivi des marges par chantier"
        hook="Vos marges, visibles en temps réel"
        description="Coût de revient actualisé, marge dégagée, écart vs devis initial — à chaque étape clé du chantier, pas seulement à la clôture."
      />
      <UsageCard
        title="Alertes dérapage automatiques"
        hook="L'alerte avant que ça dérape"
        description="Dès qu'un chantier dépasse son budget de 10% (seuil paramétrable), vous êtes alerté. Vous agissez pendant que c'est encore récupérable."
      />
      <UsageCard
        title="Suivi des sous-traitants et appels de fonds"
        hook="Vos sous-traitants, sous contrôle"
        description="Tableau de bord des montants engagés, factures attendues, écarts vs contrat. Vous validez les appels de fonds avec les bonnes informations sous les yeux."
      />
      <UsageCard
        title="Reporting chantier et analyse rentabilité"
        hook="Savoir où gagner, avant de chiffrer"
        description="Quels types de chantiers sont les plus rentables ? Quels clients paient bien et reviennent ? L'analyse pour décider où concentrer votre énergie commerciale."
      />
    </div>
  </Section>

  <!-- Gains concrets -->
  <Section variant="white">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">Ce que vous pouvez attendre</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-green-50 border border-green-200 rounded-xl p-6">
        <h3 class="font-bold text-green-900 mb-3">Marges récupérées en cours de chantier</h3>
        <p class="text-green-800 text-sm leading-relaxed">Détecter un dérapage à 50% d'avancement laisse encore de la marge de manœuvre. Nos clients PME récupèrent en moyenne 3 à 8 points de marge sur les chantiers suivis.</p>
      </div>
      <div class="bg-green-50 border border-green-200 rounded-xl p-6">
        <h3 class="font-bold text-green-900 mb-3">Moins de mauvaises surprises à la clôture</h3>
        <p class="text-green-800 text-sm leading-relaxed">Quand les alertes fonctionnent, les clôtures ne réservent plus de mauvaises surprises. Le résultat final converge avec les prévisions en cours de chantier.</p>
      </div>
      <div class="bg-green-50 border border-green-200 rounded-xl p-6">
        <h3 class="font-bold text-green-900 mb-3">Décisions commerciales mieux étayées</h3>
        <p class="text-green-800 text-sm leading-relaxed">Savoir quels chantiers sont rentables change la façon de chiffrer et de sélectionner les affaires. Sur 12 mois, l'impact sur la rentabilité globale est significatif.</p>
      </div>
    </div>
    <p class="text-xs text-gray-400 mt-4">* Résultats variables selon la taille des chantiers et les outils existants.</p>
  </Section>

  <!-- RGPD -->
  <Section variant="light">
    <h2 class="text-3xl font-bold mb-6 text-navy-900">Points de vigilance RGPD</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-red-50 border border-red-200 rounded-xl p-6">
        <h3 class="font-bold text-red-900 mb-3">Données sous-traitants et salariés chantier</h3>
        <p class="text-red-800 text-sm leading-relaxed">
          Noms, heures, salaires — ce sont des données personnelles. On anonymise systématiquement avant tout usage dans un outil IA. Les données de chantier restent dans vos outils internes.
        </p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-6">
        <h3 class="font-bold text-red-900 mb-3">Vos données de marges restent confidentielles</h3>
        <p class="text-red-800 text-sm leading-relaxed">
          Les marges par chantier sont des données stratégiques sensibles. L'architecture mise en place ne les expose à aucun tiers. Vous gardez le contrôle complet.
        </p>
      </div>
    </div>
  </Section>

  <!-- Process -->
  <Section variant="white">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">Comment on procède</h2>
    <div class="max-w-3xl space-y-8">
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-navy-900 text-white rounded-full flex items-center justify-center font-bold text-lg">1</div>
        <div>
          <h3 class="text-xl font-bold text-navy-900 mb-2">Audit — Cartographier vos chantiers et sources de données</h3>
          <p class="text-gray-600">On identifie où sont vos données (devis, factures, heures) et comment les connecter. On part de vos outils existants.</p>
        </div>
      </div>
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-navy-900 text-white rounded-full flex items-center justify-center font-bold text-lg">2</div>
        <div>
          <h3 class="text-xl font-bold text-navy-900 mb-2">Prototype — Tableau de bord sur 3 chantiers réels</h3>
          <p class="text-gray-600">On déploie le suivi sur 3 de vos chantiers en cours. Vous voyez les marges en temps réel dès la première semaine.</p>
        </div>
      </div>
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-navy-900 text-white rounded-full flex items-center justify-center font-bold text-lg">3</div>
        <div>
          <h3 class="text-xl font-bold text-navy-900 mb-2">Déploiement — Toute votre activité sous contrôle</h3>
          <p class="text-gray-600">Extension à tous vos chantiers actifs, formation de votre équipe, alertes paramétrées selon vos seuils.</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Punchline narrative -->
  <Section variant="navy">
    <div class="py-6 text-center">
      <p class="text-2xl md:text-3xl font-bold leading-relaxed">
        <span class="text-white">Vous ne payez pas un tableau de bord chantier.</span>
        <br />
        <span class="text-orange-400">Vous récupérez les marges que vous perdiez sans le savoir.</span>
      </p>
    </div>
  </Section>

  <!-- CTA -->
  <Section variant="cta">
    <div class="text-center text-white">
      <h2 class="text-3xl font-bold mb-4">Voyons ensemble vos chantiers les plus rentables</h2>
      <p class="text-gray-300 mb-8 max-w-xl mx-auto">30 minutes pour identifier où vous perdez de la marge — et comment le suivre automatiquement.</p>
      <Button href="/contact-diagnostic-ia" variant="primary">Réserver mon diagnostic</Button>
      <div class="mt-6">
        <span class="inline-block bg-orange-50 text-orange-600 text-sm font-semibold px-4 py-2 rounded-full">
          PME bâtiment
        </span>
      </div>
    </div>
  </Section>
</BaseLayout>
