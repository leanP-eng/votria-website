---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
---

<BaseLayout
  title="IA pour dirigeants de PME | VotrIA"
  description="Découvrez comment l'IA aide les dirigeants de PME à synthétiser l'information, préparer leurs décisions et gagner du temps sur les tâches chronophages."
>
  <!-- Hero -->
  <Section variant="navy">
    <div class="py-12 text-white">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">L'IA pour piloter votre PME : décider, synthétiser, gagner du temps</h1>
      <p class="text-xl text-gray-300 max-w-2xl">L'IA ne remplace pas votre jugement. Elle vous libère du temps pour l'exercer là où ça compte vraiment.</p>
    </div>
  </Section>

  <!-- Problème -->
  <Section variant="light">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">Les défis que vous connaissez</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <Card title="Vision fragmentée de vos clients" description="Vos données client sont éparpillées entre CRM, tableurs et emails. Impossible d'avoir une vue consolidée en temps réel." />
      <Card title="Données dispersées dans plusieurs outils" description="Chaque outil a ses propres chiffres. La consolidation prend du temps et génère des erreurs d'interprétation." />
      <Card title="Décisions basées sur l'intuition" description="Sans tableaux de bord clairs, les arbitrages reposent sur des ressentis plutôt que sur des données fiables." />
    </div>
  </Section>

  <!-- Solution -->
  <Section variant="white">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold mb-6 text-navy-900">La solution VotrIA</h2>
        <p class="text-gray-700 mb-4 leading-relaxed">
          Regrouper vos données client, prédire les tendances, automatiser les rapports de suivi.
          L'IA connecte vos outils existants et vous donne une vision claire sans changer votre façon de travailler.
        </p>
        <p class="text-gray-700 leading-relaxed">
          Nous identifions les données que vous avez déjà — dans votre CRM, vos factures, vos échanges email —
          et les rendons exploitables en quelques semaines.
        </p>
      </div>
      <div class="bg-orange-50 border-l-4 border-orange-500 rounded-r-xl p-6">
        <p class="text-sm font-bold text-orange-600 uppercase tracking-wide mb-3">Exemple concret</p>
        <p class="text-navy-900 font-medium leading-relaxed">
          « Un gérant BTP voit ses marges clients en temps réel, identifie les chantiers sous-performants
          et ajuste ses priorités chaque semaine — sans passer 3h à consolider des tableurs. »
        </p>
      </div>
    </div>
  </Section>

  <!-- 4 Usages prioritaires -->
  <Section variant="light">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">4 usages prioritaires pour les dirigeants</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <p class="text-orange-600 italic text-sm mb-3">"Transformez 30 pages en 5 points clés en 2 minutes"</p>
        <h3 class="text-xl font-bold text-navy-900 mb-3">Synthétiser l'information rapidement</h3>
        <p class="text-gray-600 leading-relaxed">Rapports, comptes-rendus de réunion, articles de veille, retours fournisseurs — l'IA extrait l'essentiel pour que vous décidiez sans tout lire.</p>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <p class="text-orange-600 italic text-sm mb-3">"Arrivez en réunion avec un cadre clair, pas des intuitions"</p>
        <h3 class="text-xl font-bold text-navy-900 mb-3">Préparer vos décisions et arbitrages</h3>
        <p class="text-gray-600 leading-relaxed">Structurer un arbitrage, comparer des options, préparer un CODIR. L'IA vous aide à organiser l'information avant d'entrer dans la salle.</p>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <p class="text-orange-600 italic text-sm mb-3">"Savoir sur quoi concentrer l'énergie cette semaine"</p>
        <h3 class="text-xl font-bold text-navy-900 mb-3">Mieux prioriser votre agenda et vos équipes</h3>
        <p class="text-gray-600 leading-relaxed">Classer les sujets urgents/importants, identifier les quick wins opérationnels, éviter que le quotidien écrase les priorités stratégiques.</p>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <p class="text-orange-600 italic text-sm mb-3">"Gagner 1h par jour sur les tâches de communication"</p>
        <h3 class="text-xl font-bold text-navy-900 mb-3">Rédiger et communiquer plus vite</h3>
        <p class="text-gray-600 leading-relaxed">Mails stratégiques, briefs équipe, discours, comptes-rendus de décision — l'IA rédige le premier jet, vous validez et personnalisez.</p>
      </div>
    </div>
  </Section>

  <!-- Gains concrets -->
  <Section variant="white">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">Ce que vous pouvez attendre</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-green-50 border border-green-200 rounded-xl p-6">
        <h3 class="font-bold text-green-900 mb-3">Temps récupéré chaque semaine</h3>
        <p class="text-green-800 text-sm leading-relaxed">Typiquement 3 à 5h/semaine sur la lecture, la synthèse et la rédaction. Selon votre volume d'information et vos outils actuels.</p>
      </div>
      <div class="bg-green-50 border border-green-200 rounded-xl p-6">
        <h3 class="font-bold text-green-900 mb-3">Qualité de décision améliorée</h3>
        <p class="text-green-800 text-sm leading-relaxed">Décisions mieux étayées, arbitrages plus rapides. Moins d'informations manquantes au moment où ça compte.</p>
      </div>
      <div class="bg-green-50 border border-green-200 rounded-xl p-6">
        <h3 class="font-bold text-green-900 mb-3">Moins de réunions de recalage</h3>
        <p class="text-green-800 text-sm leading-relaxed">Quand l'information circule mieux, les équipes s'alignent plus vite. Peut atteindre une réunion de moins par semaine selon le contexte.</p>
      </div>
    </div>
    <p class="text-xs text-gray-400 mt-4">* Résultats variables selon le contexte et les outils existants.</p>
  </Section>

  <!-- RGPD -->
  <Section variant="light">
    <h2 class="text-3xl font-bold mb-6 text-navy-900">Points de vigilance RGPD</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-red-50 border border-red-200 rounded-xl p-6">
        <h3 class="font-bold text-red-900 mb-3">Quelles données ne pas exposer à un LLM public</h3>
        <p class="text-red-800 text-sm leading-relaxed">
          Données financières confidentielles, données concurrentielles sensibles, données personnelles de salariés — à anonymiser systématiquement avant tout usage dans un outil IA public.
        </p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-6">
        <h3 class="font-bold text-red-900 mb-3">Bonnes pratiques pour rester en conformité</h3>
        <p class="text-red-800 text-sm leading-relaxed">
          Travailler sur des extraits anonymisés, définir un cadre interne (quels outils, quelles données, qui y accède), et vérifier la localisation des serveurs des outils utilisés.
        </p>
      </div>
    </div>
  </Section>

  <!-- Process -->
  <Section variant="white">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">Comment on procède</h2>
    <div class="max-w-3xl space-y-8">
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-navy-900 text-white rounded-full flex items-center justify-center font-bold text-lg">1</div>
        <div>
          <h3 class="text-xl font-bold text-navy-900 mb-2">Audit — Identifier vos sources de données</h3>
          <p class="text-gray-600">Cartographier vos outils, vos flux de données et vos priorités de pilotage. On part de ce que vous avez déjà.</p>
        </div>
      </div>
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-navy-900 text-white rounded-full flex items-center justify-center font-bold text-lg">2</div>
        <div>
          <h3 class="text-xl font-bold text-navy-900 mb-2">Prototype — Dashboard IA connecté</h3>
          <p class="text-gray-600">Construire une première version opérationnelle, la tester avec vous et ajuster avant le déploiement complet.</p>
        </div>
      </div>
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-navy-900 text-white rounded-full flex items-center justify-center font-bold text-lg">3</div>
        <div>
          <h3 class="text-xl font-bold text-navy-900 mb-2">Déploiement — Utilisation quotidienne</h3>
          <p class="text-gray-600">Intégration dans votre routine, formation de votre équipe, support pendant la prise en main.</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section variant="cta">
    <div class="text-center text-white">
      <h2 class="text-3xl font-bold mb-4">Commençons par identifier vos gains rapides</h2>
      <p class="text-gray-300 mb-8 max-w-xl mx-auto">30 minutes pour comprendre votre contexte et vous proposer une première piste concrète.</p>
      <Button href="/contact-diagnostic-ia" variant="primary">Réserver un diagnostic gratuit</Button>
    </div>
  </Section>
</BaseLayout>
