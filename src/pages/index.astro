---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Section from '../components/Section.astro';
---

<BaseLayout
  title="IA pour le BTP & second œuvre | VotrIA"
  description="Automatisation IA pour entreprises du BTP : suivi des devis, relances impayés, trésorerie chantier. Pensé par un gérant de TPE du bâtiment. 20 ans terrain."
>
  <!-- Section 1 — Hero -->
  <Section variant="navy">
    <div class="max-w-3xl">
      <!-- Badge spécialiste -->
      <div class="inline-block mb-6">
        <span class="bg-orange-500 text-navy-900 text-sm font-bold px-4 py-1.5 rounded-full">
          Spécialiste IA pour le BTP — second œuvre
        </span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight mb-6">
        Vos devis dorment, vos impayés traînent, vos marges chantier vous échappent&nbsp;?
      </h1>
      <p class="text-lg md:text-xl leading-relaxed mb-8 text-white/90">
        J'automatise le suivi qui plombe votre trésorerie — relances devis, factures, impayés.
        Pensé par un gérant de TPE du BTP. Surtout pas par un vendeur d'IA.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="/contact-diagnostic-ia" variant="primary">
          Diagnostic gratuit
        </Button>
        <Button href="/methode-integration-ia" variant="secondary">
          Voir la méthode
        </Button>
      </div>
    </div>
  </Section>

  <!-- Section 2 — Barre légitimité -->
  <div class="bg-navy-800 py-8 px-6 md:px-12 lg:px-20">
    <div class="max-w-6xl mx-auto text-center">
      <p class="text-white text-base md:text-lg leading-relaxed">
        20+ ans terrain BTP — Gérant de TPE et chef des ventes dans le bâtiment&nbsp;: je connais parfaitement vos clients, vos marges, vos chantiers et votre trésorerie.
      </p>
    </div>
  </div>

  <!-- Section 3 — Cas concret Peinture / agent vocal -->
  <Section variant="white">
    <div class="max-w-3xl mx-auto">
      <!-- Badge entreprise -->
      <div class="inline-block mb-6">
        <span class="bg-orange-500 text-navy-900 text-sm font-bold px-4 py-1.5 rounded-full">
          Entreprise de peinture
        </span>
      </div>

      <!-- Récit -->
      <p class="text-lg md:text-xl italic text-gray-700 leading-relaxed mb-8 font-serif">
        « Un peintre en haut de son échelle, les mains dans la peinture. Son téléphone sonne.
        Il ne peut pas décrocher. Le client au bout du fil voulait un devis. Il ne rappelle pas
        — il appelle le peintre suivant sur Google. »
      </p>

      <!-- 2 encarts côte à côte -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="border-2 border-orange-500 rounded-xl p-6">
          <p class="text-xs font-extrabold uppercase tracking-widest text-orange-500 mb-3">Le chiffre</p>
          <p class="text-navy-900 font-bold text-lg leading-snug">
            ~10&nbsp;000&nbsp;€/mois de chantiers partis chez le concurrent
          </p>
        </div>
        <div class="border-2 border-navy-900 rounded-xl p-6">
          <p class="text-xs font-extrabold uppercase tracking-widest text-navy-900 mb-3">La solution</p>
          <p class="text-navy-900 font-bold text-lg leading-snug">
            Un agent vocal décroche, qualifie, cale le RDV de devis — pendant qu'il peint
          </p>
        </div>
      </div>

      <!-- Punchline -->
      <div class="bg-navy-900 rounded-xl p-6 text-center">
        <p class="text-white font-bold text-lg mb-1">Vous ne payez pas un agent vocal.</p>
        <p class="text-orange-400 font-bold text-lg">
          Vous récupérez les chantiers que vous ratiez en peignant.
        </p>
      </div>
    </div>
  </Section>

  <!-- Section 4 — Les 4 piliers -->
  <Section variant="light">
    <h2 class="text-2xl md:text-3xl font-extrabold text-navy-900 mb-10 text-center">
      Les 4 piliers pour le BTP
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <Card
        title="Devis & trésorerie"
        description="Relances automatiques, suivi des impayés, cash qui rentre."
      >
        <div class="mt-4 flex flex-col gap-3">
          <span class="inline-block text-xs font-bold bg-orange-50 text-orange-600 border border-orange-200 px-3 py-1 rounded-full">
            Artisan / TPE
          </span>
          <a href="/devis-relances-tresorerie" class="text-sm font-bold text-orange-500 hover:text-orange-600 transition-colors">
            En savoir plus →
          </a>
        </div>
      </Card>

      <Card
        title="Commerce & relation client"
        description="Appels captés, devis envoyés, clients suivis — même en chantier."
      >
        <div class="mt-4 flex flex-col gap-3">
          <span class="inline-block text-xs font-bold bg-orange-50 text-orange-600 border border-orange-200 px-3 py-1 rounded-full">
            Artisan & PME
          </span>
          <a href="/commerce-relation-client" class="text-sm font-bold text-orange-500 hover:text-orange-600 transition-colors">
            En savoir plus →
          </a>
        </div>
      </Card>

      <Card
        title="Suivi de chantier & marges"
        description="Alertes dérapage, marges en temps réel, sous-traitants sous contrôle."
      >
        <div class="mt-4 flex flex-col gap-3">
          <span class="inline-block text-xs font-bold bg-orange-50 text-orange-600 border border-orange-200 px-3 py-1 rounded-full">
            PME bâtiment
          </span>
          <a href="/chantier-marges" class="text-sm font-bold text-orange-500 hover:text-orange-600 transition-colors">
            En savoir plus →
          </a>
        </div>
      </Card>

      <Card
        title="Administratif & RH chantier"
        description="Pointages, documents, déclarations — sans la paperasse manuelle."
      >
        <div class="mt-4 flex flex-col gap-3">
          <span class="inline-block text-xs font-bold bg-orange-50 text-orange-600 border border-orange-200 px-3 py-1 rounded-full">
            Artisan & PME
          </span>
          <a href="/admin-rh-chantier" class="text-sm font-bold text-orange-500 hover:text-orange-600 transition-colors">
            En savoir plus →
          </a>
        </div>
      </Card>
    </div>
  </Section>

  <!-- Section 5 — CTA final -->
  <Section variant="cta">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-extrabold mb-6">
        30 min pour identifier vos 2-3 automatisations prioritaires.
      </h2>
      <p class="text-lg leading-relaxed mb-8 text-white/90">
        Diagnostic gratuit, sans engagement. On parle chantier, pas techno.
      </p>
      <Button href="/contact-diagnostic-ia" variant="primary">
        Réserver mon diagnostic
      </Button>
    </div>
  </Section>
</BaseLayout>
