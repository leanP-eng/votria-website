---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
---

<BaseLayout
  title="IA pour l'administratif et les RH | VotrIA"
  description="Découvrez comment l'IA aide les fonctions support à traiter les documents, automatiser les tâches répétitives et sécuriser les données RH."
>
  <!-- Hero -->
  <Section variant="navy">
    <div class="py-12 text-white">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">IA pour l'administratif et les RH : réduire les tâches répétitives</h1>
      <p class="text-xl text-gray-300 max-w-2xl">Les fonctions support portent une charge invisible mais réelle. L'IA s'occupe du volume pour que vous vous consacriez à ce qui demande vraiment votre expertise.</p>
    </div>
  </Section>

  <!-- Problème -->
  <Section variant="light">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">Ce qui pèse sur vos équipes support</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <Card title="Tâches répétitives = temps perdu" description="Saisie de données, mise à jour de documents, réponses aux mêmes questions. Des heures chaque semaine sur des tâches sans valeur ajoutée." />
      <Card title="Documents créés manuellement" description="Contrats, devis, fiches de poste, courriers — chaque document repart de zéro ou d'un template inadapté." />
      <Card title="Erreurs administratives fréquentes" description="La saisie manuelle génère des erreurs. Les corrections prennent plus de temps que la création initiale." />
    </div>
  </Section>

  <!-- Solution -->
  <Section variant="white">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold mb-6 text-navy-900">La solution VotrIA</h2>
        <p class="text-gray-700 mb-4 leading-relaxed">
          Automatiser la génération de documents (contrats, devis, lettres), centraliser les données RH,
          éliminer les tâches rébarbatives. Vos équipes se concentrent sur ce qui demande vraiment leur expertise.
        </p>
        <p class="text-gray-700 leading-relaxed">
          On identifie les tâches les plus chronophages, on construit les automatisations adaptées,
          et on forme vos équipes pour qu'elles soient autonomes rapidement.
        </p>
      </div>
      <div class="bg-orange-50 border-l-4 border-orange-500 rounded-r-xl p-6">
        <p class="text-sm font-bold text-orange-600 uppercase tracking-wide mb-3">Exemple concret</p>
        <p class="text-navy-900 font-medium leading-relaxed">
          « Une PME génère 100 devis par mois automatiquement à partir d'un formulaire simple.
          Le commercial saisit le contexte, l'IA produit le document formaté, prêt à envoyer. »
        </p>
      </div>
    </div>
  </Section>

  <!-- 4 Usages prioritaires -->
  <Section variant="light">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">4 usages prioritaires pour l'administratif et les RH</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <p class="text-orange-600 italic text-sm mb-3">"Traitez 10 documents en le temps qu'il en faut normalement pour 2"</p>
        <h3 class="text-xl font-bold text-navy-900 mb-3">Synthétiser et traiter vos documents plus vite</h3>
        <p class="text-gray-600 leading-relaxed">Contrats, PV de réunion, rapports d'activité, dossiers fournisseurs — extraire les points clés sans tout lire ligne par ligne.</p>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <p class="text-orange-600 italic text-sm mb-3">"Une fiche de poste rédigée en 15 minutes, pas en 2 heures"</p>
        <h3 class="text-xl font-bold text-navy-900 mb-3">Rédiger vos supports internes sans partir de zéro</h3>
        <p class="text-gray-600 leading-relaxed">Fiches de poste, notes internes, courriers, procédures, règlement intérieur, comptes-rendus — l'IA rédige le premier jet sur la base de vos critères.</p>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <p class="text-orange-600 italic text-sm mb-3">"Ne plus répondre 10 fois à la même question"</p>
        <h3 class="text-xl font-bold text-navy-900 mb-3">Automatiser les réponses aux demandes fréquentes</h3>
        <p class="text-gray-600 leading-relaxed">FAQ interne, réponses types aux questions salariés, premier niveau de traitement des demandes RH courantes — sans y passer du temps à chaque fois.</p>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <p class="text-orange-600 italic text-sm mb-3">"Zéro oubli sur les échéances qui engagent la responsabilité"</p>
        <h3 class="text-xl font-bold text-navy-900 mb-3">Ne plus rater une échéance réglementaire</h3>
        <p class="text-gray-600 leading-relaxed">Rappels automatiques, suivi des délais réglementaires, extraction d'échéances depuis des documents contractuels ou légaux.</p>
      </div>
    </div>
  </Section>

  <!-- Gains concrets -->
  <Section variant="white">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">Ce que vous pouvez attendre</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-green-50 border border-green-200 rounded-xl p-6">
        <h3 class="font-bold text-green-900 mb-3">Charge administrative allégée</h3>
        <p class="text-green-800 text-sm leading-relaxed">Typiquement 3 à 8h/mois récupérées sur les tâches manuelles répétitives. Selon le volume de documents et les processus existants.</p>
      </div>
      <div class="bg-green-50 border border-green-200 rounded-xl p-6">
        <h3 class="font-bold text-green-900 mb-3">Zéro oubli sur les échéances réglementaires</h3>
        <p class="text-green-800 text-sm leading-relaxed">Les rappels automatiques suppriment le risque d'oubli sur les délais légaux, contractuels et réglementaires.</p>
      </div>
      <div class="bg-green-50 border border-green-200 rounded-xl p-6">
        <h3 class="font-bold text-green-900 mb-3">Plus de temps pour les missions à valeur ajoutée</h3>
        <p class="text-green-800 text-sm leading-relaxed">Relation salarié, recrutement, accompagnement managérial — ce qui nécessite vraiment l'expertise humaine, pas la saisie.</p>
      </div>
    </div>
    <p class="text-xs text-gray-400 mt-4">* Résultats variables selon le volume de documents et les processus existants.</p>
  </Section>

  <!-- RGPD — section étendue -->
  <Section variant="light">
    <h2 class="text-3xl font-bold mb-4 text-navy-900">Points de vigilance RGPD</h2>
    <p class="text-gray-600 mb-8 max-w-2xl">Les données RH sont la catégorie la plus sensible du RGPD : salaires, santé, disciplinaire, évaluations. Cette section mérite une attention particulière.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-red-50 border border-red-200 rounded-xl p-6">
        <h3 class="font-bold text-red-900 mb-3">Données RH : ce qu'on ne met jamais dans un LLM public</h3>
        <p class="text-red-800 text-sm leading-relaxed">
          Données nominatives RH interdites dans un LLM public sans anonymisation préalable. Paie, santé, disciplinaire, évaluations individuelles = catégories sensibles à traitement restreint.
        </p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-6">
        <h3 class="font-bold text-red-900 mb-3">Quels outils sont conformes pour quels usages</h3>
        <p class="text-red-800 text-sm leading-relaxed">
          Un DPA (Data Processing Agreement) est requis avec tout outil IA traitant des données personnelles. Vérifier la localisation des serveurs et les sous-traitants de chaque solution.
        </p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-6">
        <h3 class="font-bold text-red-900 mb-3">Mettre en place un cadre interne d'utilisation</h3>
        <p class="text-red-800 text-sm leading-relaxed">
          Définir : quels outils IA sont autorisés · quelles données peuvent y être soumises · qui y accède · comment la traçabilité est assurée. Ce cadre est indispensable avant tout déploiement RH.
        </p>
      </div>
    </div>
  </Section>

  <!-- Process -->
  <Section variant="white">
    <h2 class="text-3xl font-bold mb-10 text-navy-900">Comment on procède</h2>
    <div class="max-w-3xl space-y-8">
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-navy-900 text-white rounded-full flex items-center justify-center font-bold text-lg">1</div>
        <div>
          <h3 class="text-xl font-bold text-navy-900 mb-2">Audit — Tâches répétitives identifiées</h3>
          <p class="text-gray-600">Lister et chronométrer les tâches manuelles. Prioriser selon l'impact et la faisabilité.</p>
        </div>
      </div>
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-navy-900 text-white rounded-full flex items-center justify-center font-bold text-lg">2</div>
        <div>
          <h3 class="text-xl font-bold text-navy-900 mb-2">Prototype — Templates de documents IA</h3>
          <p class="text-gray-600">Construire les premiers templates et workflows automatisés, les tester en conditions réelles.</p>
        </div>
      </div>
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-navy-900 text-white rounded-full flex items-center justify-center font-bold text-lg">3</div>
        <div>
          <h3 class="text-xl font-bold text-navy-900 mb-2">Déploiement — Workflows automatisés</h3>
          <p class="text-gray-600">Mise en production, formation des équipes, documentation des processus pour autonomie complète.</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section variant="cta">
    <div class="text-center text-white">
      <h2 class="text-3xl font-bold mb-4">Identifions vos tâches les plus chronophages</h2>
      <p class="text-gray-300 mb-8 max-w-xl mx-auto">30 minutes pour cartographier ce qui peut être automatisé dans votre contexte.</p>
      <Button href="/contact-diagnostic-ia" variant="primary">Réserver un diagnostic gratuit</Button>
    </div>
  </Section>
</BaseLayout>
